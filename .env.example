# Token from @BotFather
BOT_TOKEN=

# Bot username without the @ (needed for the Share button)
BOT_USERNAME=

# Public https address where this app is hosted
WEBAPP_URL=

# Your Telegram user ID, comma separated for more than one admin
# (message @userinfobot on Telegram to get yours)
ADMIN_IDS=

# Days buyers have to pay after a group locks
PAY_DAYS=3

PORT=3000

# Folder for the database, receipts and product photos. Use a persistent disk in production.
DATA_DIR=./data

# Never set this on a live server. It lets anyone log in as any user.
# DEV_MODE=1
