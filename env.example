# Token from @BotFather
BOT_TOKEN=

# Bot username without the @
BOT_USERNAME=

# Public https address where this app is hosted
WEBAPP_URL=

# Your Telegram user ID, comma separated for more than one admin
# (message @userinfobot on Telegram to get yours)
ADMIN_IDS=

# PostgreSQL connection string from your database host (Neon, Supabase, Render, any Postgres)
DATABASE_URL=

# Days buyers have to pay before an unpaid order is cancelled automatically (0 turns this off)
PAY_DAYS=3

PORT=3000

# "webhook" is chosen automatically on Render. Use "polling" when running on your own computer.
# BOT_MODE=webhook

# Never set this on a live server. It lets anyone log in as any user.
# DEV_MODE=1
