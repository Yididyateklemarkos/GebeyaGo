# Token from @BotFather
BOT_TOKEN=

# Bot username without the @ (needed for the Share button)
BOT_USERNAME=

# Public https address where this app is hosted
WEBAPP_URL=

# Your Telegram user ID, comma separated for more than one admin
# (message @userinfobot on Telegram to get yours)
ADMIN_IDS=

# Days buyers have to pay before an unpaid order is cancelled automatically (0 turns this off)
PAY_DAYS=3

# Online payment with Verify Checkout (optional). Leave empty to use manual receipts only.
# Create these in the Verify Checkout dashboard. Keep them secret, never commit them.
VERIFY_API_KEY=
VERIFY_WEBHOOK_SECRET=

PORT=3000

# Folder for the database, receipts and product photos. Use a persistent disk in production.
DATA_DIR=./data

# Never set this on a live server. It lets anyone log in as any user.
# DEV_MODE=1
